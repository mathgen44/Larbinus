# ============================================================
#  Larbinus — configuration
#  Copier ce fichier en `.env` puis renseigner ce qui est utile.
#  Un fournisseur sans clé (ou sans URL) est simplement désactivé :
#  le conteneur démarre même avec un seul fournisseur configuré.
# ============================================================

# --- Application ---------------------------------------------
# Port publié sur le LAN (le port interne du conteneur reste 8080, toujours).
# 8474 est retenu par défaut : hors des plages très encombrées et hors de la
# plage éphémère du noyau (32768+). Vérifier qu'il est libre :  ss -tlnp | grep 8474
LARBINUS_PORT=8474

# Si renseignée, les routes /v1 (n8n, scripts, SDK OpenAI) exigent cette clé,
# via l'en-tête `X-API-Key` ou `Authorization: Bearer <clé>`.
# Laisser vide pour un accès libre.
LARBINUS_API_KEY=

# Étend l'exigence de clé aux routes /api, donc à l'interface web elle-même.
# À faux, l'interface reste utilisable sans clé sur le LAN — et avec elle les
# documents indexés. À passer à vrai dès que Larbinus est exposé au-delà d'un
# réseau de confiance.
LARBINUS_PROTECT_UI=false

# Origines autorisées pour le navigateur (séparées par des virgules), * en dev.
CORS_ORIGINS=*

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# texte (lisible à l'œil) | json (exploitable par un collecteur de logs)
LOG_FORMAT=texte

# --- Limitation de débit -------------------------------------------------
# Requêtes autorisées par adresse et par fenêtre (en secondes). 0 désactive.
# Empêche surtout qu'un script en boucle ne vide un quota d'API payante.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# Adresses des reverse proxys autorisés à annoncer l'IP réelle du client via
# `X-Forwarded-For` (séparées par des virgules). Sans cette liste l'en-tête est
# ignoré — sinon n'importe qui contournerait la limitation en le falsifiant.
# Exemple derrière Nginx Proxy Manager : TRUSTED_PROXIES=172.18.0.1
TRUSTED_PROXIES=

# Répertoire persistant dans le conteneur (monté sur ./data).
DATA_DIR=/data

# --- Ollama (instance locale) --------------------------------
# Laisser vide pour désactiver. Exemples :
#   http://192.168.0.139:11434        (serveur Ollama dédié sur le LAN)
#   http://host.docker.internal:11434 (Ollama installé sur l'hôte Docker)
#   http://ollama:11434               (conteneur Ollama sur le même réseau Docker)
OLLAMA_BASE_URL=

# --- OpenAI et API compatibles -------------------------------
# Fonctionne aussi avec OpenRouter, Groq, vLLM, LM Studio…
# en changeant simplement OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) --------------------------------------
ANTHROPIC_API_KEY=

# --- Mistral AI (cloud) --------------------------------------
MISTRAL_API_KEY=

# --- Documents et RAG ----------------------------------------
# Fournisseur d'embeddings : ollama | openai | (vide pour désactiver le RAG).
# Indépendant du modèle de conversation : on peut discuter avec une API en
# ligne tout en vectorisant ses documents en local, ce qui évite de les
# envoyer chez un tiers.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Dossier surveillé, à monter dans le conteneur (voir docker-compose.yml).
# Tout fichier reconnu qu'on y dépose est indexé au prochain scan.
DOCUMENTS_DIR=/documents

# Nombre d'extraits injectés dans le prompt, et découpage des documents.
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
MAX_DOCUMENT_BYTES=26214400

# --- Outils des larbins --------------------------------------
# Machines joignables en SSH : nom=utilisateur@hote[:port], séparées par des
# virgules. Un larbin ne peut viser QUE ces machines. Vide : outil désactivé.
#   SSH_HOSTS=beast=larbinus@192.168.0.139,vm=larbinus@192.168.0.40
SSH_HOSTS=

# Clé privée dédiée, montée en lecture seule (voir docker-compose.yml).
# Créez un compte restreint sur les machines cibles plutôt que d'utiliser
# votre clé personnelle : c'est ce compte, et non Larbinus, qui décide de ce
# qu'un modèle peut réellement faire.
SSH_KEY_PATH=/ssh/id_ed25519
SSH_KNOWN_HOSTS=/ssh/known_hosts

# Délais et taille des sorties renvoyées au modèle.
SSH_TIMEOUT=30
SSH_CONNECT_TIMEOUT=5
TOOL_OUTPUT_LIMIT=6000

# Nombre d'enchaînements automatiques après exécution d'un outil de
# consultation. Un plafond bas évite qu'une boucle mal engagée ne parte seule.
TOOL_MAX_ITERATIONS=3

# Services joignables par l'outil http : hote[:port], séparés par des virgules.
# Souvent plus sûr que SSH — une API refuse ce qu'elle n'expose pas.
#   HTTP_ALLOWED_HOSTS=192.168.0.40:9000,proxmox.lan:8006
HTTP_ALLOWED_HOSTS=

# En-têtes par service, au format JSON. Sert aux API qui exigent un jeton.
#   HTTP_HEADERS={"192.168.0.40:9000": {"X-API-Key": "..."}}
HTTP_HEADERS=
HTTP_TIMEOUT=20

# Recherche web via une instance SearXNG exposant le format JSON.
# SearXNG le désactive par défaut : ajoutez « json » à `search.formats` dans
# son settings.yml, sinon il répondra 403.
#   WEB_SEARCH_URL=http://192.168.0.40:8080/search
WEB_SEARCH_URL=
WEB_SEARCH_RESULTS=5

# --- Sélection par défaut de l'interface ---------------------
# DEFAULT_PROVIDER : ollama | openai | anthropic | mistral
DEFAULT_PROVIDER=
DEFAULT_MODEL=
